{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-bedouin-catering",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catering-db",
      "database_id": "dcfe0aa1-4131-492b-84d1-0b8adcbaa967",
      "migrations_dir": "migrations",
      // Only numbered files are migrations, so migrations/seed.sql never runs on apply.
      "migrations_pattern": "migrations/0*.sql"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "87c00d5da38941589bd26bd6323fa084"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "catering-media"
    }
  ],
  "vars": {
    // Public Turnstile site key. This is Cloudflare's always-pass TEST key: replace it with the
    // real widget's site key before launch. The secret goes in TURNSTILE_SECRET (wrangler secret put).
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
