{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-bedouin-catering",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catering-db",
      "database_id": "dcfe0aa1-4131-492b-84d1-0b8adcbaa967",
      "migrations_dir": "migrations",
      // Only numbered files are migrations, so migrations/seed.sql never runs on apply.
      "migrations_pattern": "migrations/0*.sql"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "87c00d5da38941589bd26bd6323fa084"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "catering-media"
    }
  ],
  // Cloudflare Images: converts uploads to WebP and serves resized AVIF/WebP via /img.
  "images": { "binding": "IMAGES" },
  // Cloudflare Email Sending. The sender domain must be onboarded in Email Service first.
  "send_email": [{ "name": "EMAIL" }],
  "routes": [{ "pattern": "bedouin.ssalam.co.uk", "custom_domain": true }],
  "vars": {
    // Sender for enquiry alerts; must be on the onboarded domain. Recipient is the NOTIFY_TO secret.
    "NOTIFY_FROM": "enquiries@ssalam.co.uk",
    // Public Turnstile site key for bedouin.ssalam.co.uk. The secret is the TURNSTILE_SECRET Worker secret;
    // Local dev overrides this with the test site key + test secret in .dev.vars.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF4m-1yy7CpkwZNE",
    // Cloudflare Access for /admin: team domain (e.g. "bedouin.cloudflareaccess.com") and the Access
    // application's Audience (AUD) tag. /admin answers 503 until both are set.
    "ACCESS_TEAM_DOMAIN": "jolly-rain-2197.cloudflareaccess.com",
    "ACCESS_AUD": "80080a462dd58d1a0d39cce3b22f7ec46e240fdf0d3e2606d725af0594f070b0"
  }
}
